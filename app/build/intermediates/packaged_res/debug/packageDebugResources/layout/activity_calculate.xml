<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color3"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".Activity.CalculateActivity">

    <FrameLayout
        android:id="@+id/calculate_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color1">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/calculate_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color1"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
            app:title="@string/sonuc"
            app:titleTextColor="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="30dp"
        android:background="@color/color2"
        android:orientation="vertical"
        android:padding="5dp">

        <LinearLayout style="@style/ResultRow">
            <TextView
                style="@style/ResultLabel"
                android:text="@string/damla_dk" />
            <TextView
                android:id="@+id/calculate_result_text"
                style="@style/ResultValue"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout style="@style/ResultRow">
            <TextView
                style="@style/ResultLabel"
                android:text="@string/aralik_sayisi" />
            <TextView
                android:id="@+id/calculate_range_text"
                style="@style/ResultValue" />
        </LinearLayout>

        <LinearLayout style="@style/ResultRow">
            <TextView
                style="@style/ResultLabel"
                android:text="@string/ml_saat" />
            <TextView
                android:id="@+id/calculate_mlh_text"
                style="@style/ResultValue" />
        </LinearLayout>

        <LinearLayout style="@style/ResultRow">
            <TextView
                style="@style/ResultLabel"
                android:text="@string/konsantrasyon" />
            <TextView
                android:id="@+id/calculate_conc_text"
                style="@style/ResultValue"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/calculate_warning_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="12dp"
        android:background="@color/warning_bg"
        android:padding="10dp"
        android:textColor="@color/warning_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/calculata_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:contentDescription="@null"
            android:src="@drawable/damla"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
